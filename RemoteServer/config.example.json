{
  "_说明": "把本文件复制成同目录的 config.json 再改；config.json 不存在时服务器使用内置默认值（与这份内容一致）。字段可以只写想改的那几个，其余自动继承默认值。",

  "server": {
    "host": "0.0.0.0",
    "port": 8787,
    "path": "/ws",
    "healthPath": "/health",
    "trustProxy": true,
    "maxConnections": 5000
  },

  "room": {
    "maxMembers": 2,
    "idMin": 10000000,
    "idMax": 99999999,
    "maxIdAttempts": 64,
    "idleMs": 600000
  },

  "limits": {
    "maxWireBytes": 65536,
    "maxBadMessages": 20,
    "maxFragments": 128
  },

  "timeout": {
    "idleMs": 30000,
    "sweepMs": 30000,
    "closeGraceMs": 500
  },

  "rateLimit": {
    "enabled": true,
    "windowMs": 60000,
    "maxCreatePerWindow": 10,
    "maxJoinPerWindow": 10
  },

  "log": {
    "dir": "logs",
    "level": "info",
    "ipMode": "full",
    "console": true,
    "maxFileBytes": 10485760,
    "retainDays": 14,
    "statsIntervalMs": 300000
  }
}
